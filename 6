6.	Generate fractal patterns using i) Bezier ii) Koch Curve –


#include <graphics.h>
#include <stdio.h>
#include <conio.h>

void bezier(int x[4], int y[4])
{
    float t, xt, yt;

    for(t = 0.0; t <= 1.0; t += 0.0005)
    {
        xt = x[0]*pow(1-t,3) +
             3*x[1]*t*pow(1-t,2) +
             3*x[2]*pow(t,2)*(1-t) +
             x[3]*pow(t,3);

        yt = y[0]*pow(1-t,3) +
             3*y[1]*t*pow(1-t,2) +
             3*y[2]*pow(t,2)*(1-t) +
             y[3]*pow(t,3);

        putpixel(xt, yt, WHITE);
    }
}

int main()
{
    int gd = DETECT, gm;

    int x[4] = {100, 150, 250, 300};
    int y[4] = {300, 100, 100, 300};

    initgraph(&gd, &gm, "");

    bezier(x, y);

    getch();
    closegraph();
    return 0;
}



