#include <graphics.h>
#include <math.h>
#include <stdio.h>
#include <conio.h>

void koch(int x1, int y1, int x2, int y2, int it)
{
    float angle = 60 * 3.14 / 180;
    int x3, y3, x4, y4, x, y;

    if(it == 0)
    {
        line(x1, y1, x2, y2);
    }
    else
    {
        x3 = (2*x1 + x2) / 3;
        y3 = (2*y1 + y2) / 3;

        x4 = (x1 + 2*x2) / 3;
        y4 = (y1 + 2*y2) / 3;

        x = x3 + (x4 - x3)*cos(angle) + (y4 - y3)*sin(angle);
        y = y3 - (x4 - x3)*sin(angle) + (y4 - y3)*cos(angle);

        koch(x1, y1, x3, y3, it-1);
        koch(x3, y3, x, y, it-1);
        koch(x, y, x4, y4, it-1);
        koch(x4, y4, x2, y2, it-1);
    }
}

int main()
{
    int gd = DETECT, gm;

    initgraph(&gd, &gm, "");

    koch(100, 300, 500, 300, 4);

    getch();
    closegraph();

    return 0;
}
